#!/bin/sh
# what-stack - Pre-push quality gate.

set -eu

ensure_cargo() {
    if command -v cargo >/dev/null 2>&1; then
        return 0
    fi

    if [ -f "$HOME/.cargo/env" ]; then
        . "$HOME/.cargo/env"
    fi

    if command -v cargo >/dev/null 2>&1; then
        return 0
    fi

    if [ -x "$HOME/.cargo/bin/cargo" ]; then
        PATH="$HOME/.cargo/bin:$PATH"
        export PATH
        return 0
    fi

    echo "ERROR: cargo is not available in the git hook environment."
    exit 1
}

ensure_cargo

echo "what-stack pre-push quality gate"

echo "-> [1/7] Checking formatting..."
cargo fmt --all -- --check

echo "-> [2/7] Running cross-target clippy..."
sh scripts/check-platform-clippy.sh

echo "-> [3/7] Running tests..."
cargo test --locked --lib --tests
cargo test --locked --doc

# Benchmarks only compile here; running them needs Valgrind and
# gungraun-runner, which Linux CI provides.
echo "-> [4/7] Compiling benchmarks..."
cargo bench --locked --no-run

echo "-> [5/7] Building crate..."
cargo build --locked

echo "-> [6/7] Building docs..."
RUSTDOCFLAGS="-D warnings -D rustdoc::bare_urls -D rustdoc::invalid_rust_codeblocks -D rustdoc::private_intra_doc_links -D rustdoc::unescaped_backticks" cargo doc --locked --no-deps

echo "-> [7/7] Auditing dependencies..."
if command -v cargo-deny >/dev/null 2>&1; then
    cargo deny check 2>/dev/null || echo "Dependency audit failed locally; CI enforces this gate."
else
    echo "cargo-deny not installed, skipping local audit."
fi

echo "All pre-push gates passed."
